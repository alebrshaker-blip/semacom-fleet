APP_ENV=production
SECRET_KEY=
# PostgreSQL / Supabase, e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/semacom
# Supabase Storage (vehicle report videos are compressed in the browser to <=45 MB
# so they remain within Supabase Free's 50 MB per-file upload limit)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public anon/publishable key; used by the browser for signed uploads.
SUPABASE_ANON_KEY=
# Legacy alias accepted when it contains an anon/publishable key (never a secret key).
SUPABASE_KEY=
SUPABASE_BUCKET=app-files
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false
HOST=0.0.0.0
PORT=8000
SESSION_COOKIE_SECURE=
MAX_CONTENT_LENGTH_MB=32
DEFAULT_BASE_URL=http://localhost:5000
PUBLIC_BASE_URL=
GTK_PATH=C:\Program Files\GTK3-Runtime Win64\bin
